{
  "name": "litreview-mcp",
  "version": "0.1.0",
  "description": "An MCP server for literature reviews: search papers, follow citations, find open-access PDFs.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/stdio.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/smoke.ts",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/stdio.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
